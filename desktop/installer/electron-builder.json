{
  "appId": "kr.snu.youngmini.desktop",
  "productName": "YoungMini",
  "electronVersion": "45.5.0",
  "directories": {"output": "../dist", "buildResources": "../installer"},
  "artifactName": "youngmin-windows-x64-setup-v${version}.${ext}",
  "publish": null,
  "win": {"target": [{"target": "nsis", "arch": ["x64"]}], "executableName": "YoungMini", "signAndEditExecutable": false},
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "영민이",
    "uninstallDisplayName": "영민이 (Young Mini)",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "installerLanguages": ["ko_KR"],
    "language": "1042",
    "include": "installer.nsh"
  }
}
