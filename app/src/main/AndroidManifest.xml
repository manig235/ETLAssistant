<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 재부팅 뒤 마감·내 마감 알림 알람을 다시 건다(SystemEventReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 배터리 최적화 예외 요청(앱을 닫아도 알림 확인이 제때 돌도록). APK 직접 배포라 Play 정책과 무관. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".Phase0App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Phase0">

        <!-- 받은 파일과 첨부를 다른 앱으로 열거나 공유할 때 쓰는 임시 권한 URI. 외부에 공개하지 않는다. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver android:name="kr.snu.etlassistant.widget.DeadlineWidgetProvider"
            android:label="@string/widget_deadlines_name" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/deadline_widget" />
        </receiver>
        <receiver android:name="kr.snu.etlassistant.widget.TimetableWidgetProvider"
            android:label="@string/widget_timetable_name" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/timetable_widget" />
        </receiver>

        <receiver android:name="kr.snu.etlassistant.widget.CompactDeadlineWidgetProvider"
            android:label="@string/widget_deadlines_compact_name" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/deadline_compact_widget" />
        </receiver>
        <receiver android:name="kr.snu.etlassistant.widget.TallTimetableWidgetProvider"
            android:label="@string/widget_timetable_tall_name" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/timetable_tall_widget" />
        </receiver>
        <receiver android:name="kr.snu.etlassistant.widget.NextClassWidgetProvider"
            android:label="@string/widget_next_class_name" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/next_class_widget" />
        </receiver>

        <receiver
            android:name="kr.snu.etlassistant.notify.DeadlineAlarmReceiver"
            android:exported="false" />

        <!-- 시스템 방송만 받는다(exported=false여도 시스템이 보내는 방송은 온다). -->
        <receiver
            android:name="kr.snu.etlassistant.notify.SystemEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".RunService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name="kr.snu.etlassistant.chat.ChatActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ETL.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="kr.snu.etlassistant.onboarding.OnboardingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="kr.snu.etlassistant.chat.SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="kr.snu.etlassistant.chat.TimetableActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="kr.snu.etlassistant.chat.NotifyHistoryActivity"
            android:exported="false" />

        <activity
            android:name="kr.snu.etlassistant.chat.CourseAlertsActivity"
            android:exported="false" />

        <activity
            android:name="kr.snu.etlassistant.chat.MyDeadlinesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
