<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12(API 31)+: 클라우드 백업과 기기 간 이전(D2D)에서 앱 데이터를 하나도 내보내지 않는다.
  allowBackup="false"만으로는 targetSdk 31+에서 기기 간 이전이 막히지 않는다.
  codex-home/auth.json(ChatGPT 로그인), 대화, Codex 세션 기록, eTL 캐시가 새 폰으로 복사되지 않게 한다.
  Keystore로 암호화한 eTL 토큰은 키가 기기에 묶여 있어 옮겨도 못 쓰지만, 그것도 함께 뺀다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
