<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="설정"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 계정 -->
        <TextView
            style="@style/SectionTitle"
            android:text="ChatGPT 계정" />

        <TextView
            android:id="@+id/accountStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp" />

        <LinearLayout style="@style/ButtonRow">
            <Button android:id="@+id/btnLoginBrowser" style="@style/RowButton" android:text="브라우저로 로그인" />
            <Button android:id="@+id/btnLoginDevice" style="@style/RowButton" android:text="기기 코드로 로그인" />
            <Button android:id="@+id/btnLogout" style="@style/RowButton" android:text="로그아웃" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/loginPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/panel_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/loginInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/loginCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textIsSelectable="true"
                android:textSize="30sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout style="@style/ButtonRow">
                <Button android:id="@+id/btnCopyCode" style="@style/RowButton" android:text="코드 복사" />
                <Button android:id="@+id/btnOpenLogin" style="@style/RowButton" android:text="브라우저 다시 열기" />
                <Button android:id="@+id/btnCancelLogin" style="@style/RowButton" android:text="취소" />
            </LinearLayout>
        </LinearLayout>

        <!-- API 키 -->
        <TextView
            style="@style/SectionTitle"
            android:text="OpenAI API 키 (고급, 선택)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ChatGPT 계정 대신 본인의 API 키를 쓸 수 있습니다. 사용한 만큼 본인의 OpenAI 계정에 요금이 청구됩니다. 키는 이 폰의 Keystore에 암호화해 저장하고, 실행할 때만 환경변수로 넘깁니다."
            android:textColor="@color/notice_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/apiKeyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

        <LinearLayout style="@style/ButtonRow">
            <EditText
                android:id="@+id/apiKeyInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:fontFamily="monospace"
                android:hint="sk-… 붙여넣기"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:textSize="13sp" />
            <Button android:id="@+id/btnApiKeySave" style="@style/RowButton" android:text="저장" />
            <Button android:id="@+id/btnApiKeyClear" style="@style/RowButton" android:text="삭제" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/useApiKey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API 키로 사용 (끄면 ChatGPT 계정)" />

        <!-- eTL -->
        <TextView
            style="@style/SectionTitle"
            android:text="eTL 토큰" />

        <TextView
            android:id="@+id/etlStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp" />

        <LinearLayout style="@style/ButtonRow">
            <EditText
                android:id="@+id/etlTokenInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:fontFamily="monospace"
                android:hint="eTL 토큰 붙여넣기"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:textSize="13sp" />
            <Button android:id="@+id/btnTokenSave" style="@style/RowButton" android:text="저장" />
            <Button android:id="@+id/btnTokenClear" style="@style/RowButton" android:text="삭제" />
        </LinearLayout>

        <Button
            android:id="@+id/btnOpenEtl"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="eTL 토큰 만들러 가기 (브라우저)" />

        <!-- 알림 -->
        <TextView
            style="@style/SectionTitle"
            android:text="알림" />

        <TextView
            android:id="@+id/notifyTokenWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="eTL 토큰을 먼저 저장해야 알림이 동작합니다."
            android:textColor="@color/notice_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="마감·공지 확인은 몇 시간마다 백그라운드에서 합니다. AI는 쓰지 않으며 eTL 토큰이 필요합니다."
            android:textColor="@color/notice_text"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/notifyDeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="마감 임박 알림 (3일 전, 24시간 전)" />

        <CheckBox
            android:id="@+id/notifyAnnouncement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="새 공지 알림" />

        <CheckBox
            android:id="@+id/notifyBrief"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="정기 브리핑" />

        <LinearLayout
            android:id="@+id/briefArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout style="@style/ButtonRow">
                <Button android:id="@+id/btnBrief1" style="@style/RowButton" android:text="오전 8:00" />
                <Button android:id="@+id/btnBriefAdd" style="@style/RowButton" android:text="+ 시각 추가" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/briefRow2"
                style="@style/ButtonRow"
                android:visibility="gone">
                <Button android:id="@+id/btnBrief2" style="@style/RowButton" android:text="오후 8:00" />
                <Button android:id="@+id/btnBriefRemove2" style="@style/RowButton" android:text="삭제" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="확인 주기"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/intervalGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/interval1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1시간"
                android:textSize="13sp" />
            <RadioButton
                android:id="@+id/interval3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="3시간"
                android:textSize="13sp" />
            <RadioButton
                android:id="@+id/interval6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="6시간"
                android:textSize="13sp" />
            <RadioButton
                android:id="@+id/interval12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="12시간"
                android:textSize="13sp" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/notifyQuiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="방해 금지 시간에는 마감·공지 알림 미루기" />

        <LinearLayout
            android:id="@+id/quietArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout style="@style/ButtonRow">
                <Button android:id="@+id/btnQuietStart" style="@style/RowButton" android:text="시작 23:00" />
                <Button android:id="@+id/btnQuietEnd" style="@style/RowButton" android:text="종료 07:00" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="정기 브리핑은 방해 금지와 무관하게 정해진 시각에 옵니다."
                android:textColor="@color/notice_text"
                android:textSize="13sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/notifyHide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="잠금화면에서 알림 내용 숨기기" />

        <TextView
            android:id="@+id/notifyPermStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="알림 권한: 확인하는 중…"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnNotifyPerm"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="권한 요청"
            android:visibility="gone" />

        <TextView
            android:id="@+id/notifyLastCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/notifyLastBrief"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="14sp" />

        <LinearLayout style="@style/ButtonRow">
            <Button android:id="@+id/btnCheckNow" style="@style/RowButton" android:text="지금 확인" />
            <Button android:id="@+id/btnBriefNow" style="@style/RowButton" android:text="브리핑 미리 보내기" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDev"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="개발자 도구" />
    </LinearLayout>
</ScrollView>
