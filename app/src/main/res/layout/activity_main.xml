<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="11sp" />

    <CheckBox
        android:id="@+id/optProxy"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="프록시 사용 (HTTPS_PROXY → 앱 내 CONNECT 프록시)" />

    <CheckBox
        android:id="@+id/optSsl"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="SSL_CERT_FILE 지정 (assets/cacert.pem)" />

    <CheckBox
        android:id="@+id/optSandbox"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="exec에 --sandbox danger-full-access" />

    <CheckBox
        android:id="@+id/optEtl"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="eTL 도구(MCP) 사용" />

    <TextView
        android:id="@+id/etlStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="11sp" />

    <LinearLayout style="@style/ButtonRow">
        <EditText
            android:id="@+id/etlToken"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:fontFamily="monospace"
            android:hint="eTL 토큰 붙여넣기"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:textSize="13sp" />
        <Button android:id="@+id/btnTokenSave" style="@style/RowButton" android:text="토큰 저장" />
    </LinearLayout>

    <LinearLayout style="@style/ButtonRow">
        <Button android:id="@+id/btnTokenClear" style="@style/RowButton" android:text="토큰 삭제" />
        <Button android:id="@+id/btnEtlTest" style="@style/RowButton" android:text="도구 직접 테스트" />
        <Button android:id="@+id/btnExecEtl" style="@style/RowButton" android:text="exec eTL" />
    </LinearLayout>

    <LinearLayout style="@style/ButtonRow">
        <Button android:id="@+id/btnVersion" style="@style/RowButton" android:text="--version" />
        <Button android:id="@+id/btnExec" style="@style/RowButton" android:text="exec 안녕" />
        <Button android:id="@+id/btnStop" style="@style/RowButton" android:text="Stop" />
    </LinearLayout>

    <LinearLayout style="@style/ButtonRow">
        <Button android:id="@+id/btnLogin" style="@style/RowButton" android:text="login" />
        <Button android:id="@+id/btnDeviceAuth" style="@style/RowButton" android:text="login --device-auth" />
        <Button android:id="@+id/btnLoginStatus" style="@style/RowButton" android:text="login status" />
    </LinearLayout>

    <LinearLayout style="@style/ButtonRow">
        <EditText
            android:id="@+id/customArgs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:fontFamily="monospace"
            android:hint="codex 인자 (예: --help)"
            android:importantForAutofill="no"
            android:inputType="text"
            android:textSize="13sp" />
        <Button android:id="@+id/btnCustom" style="@style/RowButton" android:text="Run" />
    </LinearLayout>

    <LinearLayout style="@style/ButtonRow">
        <Button android:id="@+id/btnOpenUrl" style="@style/RowButton" android:text="URL 다시 열기" />
        <Button android:id="@+id/btnCopy" style="@style/RowButton" android:text="Copy log" />
        <Button android:id="@+id/btnClear" style="@style/RowButton" android:text="Clear log" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#11888888"
        android:fillViewport="true">

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="4dp"
            android:textIsSelectable="true"
            android:textSize="10sp" />
    </ScrollView>
</LinearLayout>
