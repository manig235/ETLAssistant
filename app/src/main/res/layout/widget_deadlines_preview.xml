<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="6dp" android:background="@drawable/widget_background">
    <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="22dp" android:text="일정"
        android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_accent" />
    <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="과제 제출"
        android:textSize="11sp" android:textStyle="bold" android:textColor="@color/widget_foreground" />
    <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="오늘 23:59\n3시간 남음"
        android:textSize="9sp" android:textColor="@color/widget_secondary" />
    <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:src="@drawable/widget_item_divider" android:contentDescription="@null" />
    <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="신청서 보내기"
        android:textSize="11sp" android:textStyle="bold" android:textColor="@color/widget_foreground" />
    <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="내일 18:00\n1일 2시간 남음"
        android:textSize="9sp" android:textColor="@color/widget_secondary" />
</LinearLayout>
